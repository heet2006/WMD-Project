    },
    {
      "name": "4. Error Handling Verification",
      "item": [
        {
          "name": "Validation Error (400 Bad Request) — Out of Range Attendance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": \"STU_ERR\",\n  \"name\": \"Invalid Student\",\n  \"email\": \"invalid@campus.edu\",\n  \"course\": \"Computer Science\",\n  \"semester\": 4,\n  \"attendancePercentage\": 140.0,\n  \"studyHoursPerDay\": 4.0,\n  \"previousMarks\": 70.0,\n  \"assignmentCompletion\": 80.0,\n  \"internalMarks\": 20.0,\n  \"missedClasses\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students"]
            }
          }
        },
        {
          "name": "Unauthorized Error (401 Unauthorized) — Missing Token",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/students/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "1"]
            }
          }
        },
        {
          "name": "Not Found Error (404 Not Found) — Non-existent ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/students/999999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "students", "999999"]
            }
          }
        }
      ]
    }
  ]
